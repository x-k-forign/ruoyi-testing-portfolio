# Source snapshots exclude nested repositories and generated/local files.
**/.git/
**/.local/
**/node_modules/
**/target/
**/dist/
**/.venv/
**/__pycache__/

# Secrets and local configuration (sanitized examples are allowed).
.env
.env.*
!.env.example
!/sources/frontend/.env.development
!/sources/frontend/.env.production
!/sources/frontend/.env.staging
**/application-local.yml
**/application-local.yaml
*.pem
*.key
*.p12
*.pfx
/private/
/backups/
/raw_logs/
*.sql
!/sources/backend/sql/
!/sources/backend/sql/*.sql
*.dump
*.bak
*.bkp
**/.$*
*.log
!/basic_setting_period2/evidence_t2_3/后端启动信息.log
!/basic_setting_period2/evidence_t2_4/后端重启摘要.log

# Editor, Office and operating-system temporary files.
~$*
*.tmp
*.swp
.DS_Store
Thumbs.db
desktop.ini

# T3 deliverables: include only the agreed files and folders.
/functional_testing_period3/*
!/functional_testing_period3/Bug附件/
!/functional_testing_period3/docs/
!/functional_testing_period3/evidence_t3/
!/functional_testing_period3/evidence_t3_1/
!/functional_testing_period3/T3_缺陷报告.md
!/functional_testing_period3/T3逐例执行计划与记录模板.xlsx
!/functional_testing_period3/若依用户权限主线需求分析.xmind
!/functional_testing_period3/若依主线测试用例_T3优化版.xlsx


# Working backups and generation helpers stay local at every depth.
**/backups/
**/execution_build/
*.inspect.ndjson
*.lnk

# T4 reviewed deliverables and sanitized execution evidence.
/api_testing_period4/*
!/api_testing_period4/docs/
!/api_testing_period4/evidence_t4/
!/api_testing_period4/postman/
!/api_testing_period4/若依接口文档.md
!/api_testing_period4/T4.6_104条断言说明.md
!/api_testing_period4/T4接口用例执行记录.xlsx
!/api_testing_period4/evidence_t4/**/*_cli.log
!/functional_testing_period3/T4后续执行入口.md
