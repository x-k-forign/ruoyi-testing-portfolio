+    // T5.5 isolated laboratory only. Controlled by exact point and username.
+    private void failForT3(String point, SysUser user)
+    {
+        if (point.equals(System.getProperty("t3.fault.point"))
+                && user.getUserName() != null
+                && user.getUserName().equals(System.getProperty("t3.fault.user")))
+        {
+            boolean active = org.springframework.transaction.support.TransactionSynchronizationManager.isActualTransactionActive();
+            throw new IllegalStateException("T3_FAULT:" + point + ":txActive=" + active
+                    + ":userId=" + user.getUserId() + ":userName=" + user.getUserName());
+        }
+    }
