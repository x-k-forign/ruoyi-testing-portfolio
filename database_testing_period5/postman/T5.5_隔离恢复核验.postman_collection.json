  "item": [
    {
      "name": "管理员身份",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/getInfo",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function block(m){pm.request.url.update('t4blocked://isolated-precondition');postman.setNextRequest(null);throw new Error(m);}if(pm.environment.get('baseUrl')!=='http://127.0.0.1:18080'||!pm.environment.get('adminToken'))block('Isolated target and fresh token required');if(pm.request.method!=='GET')block('Read-only verification');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function check(n,ok){pm.test(n,function(){pm.expect(Boolean(ok)).to.equal(true);});if(!ok){postman.setNextRequest(null);throw new Error(n);}}var b=pm.response.json();check('HTTP 200',pm.response.code===200);check('Business 200',b.code===200);",
              "check('Admin identity',b.user.userId===1);",
              "console.log('T55_EVENT '+JSON.stringify(Object.assign({name:pm.info.requestName,code:b.code},{userId:b.user.userId}))); "
            ]
          }
        }
      ]
    },
