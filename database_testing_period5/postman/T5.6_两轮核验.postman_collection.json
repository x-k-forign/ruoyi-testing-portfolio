    {
      "name": "user_pages",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('requestToken',pm.environment.get('userToken'));function block(m){pm.request.url.update('t4blocked://t56');postman.setNextRequest(null);throw new Error(m);}if(pm.environment.get('baseUrl')!=='http://127.0.0.1:18080'||!pm.environment.get('requestToken')||!pm.environment.get('targetId')||!pm.environment.get('expectedRows'))block('Missing isolated round prerequisites');if(pm.request.method!=='GET')block('Read only');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function check(n,ok){pm.test(n,function(){pm.expect(Boolean(ok)).to.equal(true);});if(!ok){postman.setNextRequest(null);throw new Error(n);}}var b=pm.response.json();check('HTTP 200',pm.response.code===200);check('Business 200',b.code===200);var ex=JSON.parse(pm.environment.get('expectedRows'));var pg=Number(pm.environment.get('page'));check('Shape',Array.isArray(b.rows)&&Number.isInteger(b.total));check('Total',b.total===ex.length);check('Ordered page IDs',JSON.stringify(b.rows.map(u=>u.userId))===JSON.stringify(ex.slice((pg-1)*5,pg*5).map(u=>u.user_id)));var ids=JSON.parse(pm.environment.get('actualIds'));ids.push(...b.rows.map(u=>u.userId));pm.environment.set('actualIds',JSON.stringify(ids));if(pg*5<b.total){pm.environment.set('page',pg+1);postman.setNextRequest(pm.info.requestName);}else{check('Full ID set without duplicates',JSON.stringify(ids)===JSON.stringify(ex.map(u=>u.user_id))&&new Set(ids).size===ids.length);}console.log('T56_EVENT '+JSON.stringify(Object.assign({name:pm.info.requestName,code:b.code},{page:pg,total:b.total,ids:b.rows.map(u=>u.userId)})));"
            ]
          }
