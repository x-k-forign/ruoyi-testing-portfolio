            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function check(n,ok){pm.test(n,function(){pm.expect(Boolean(ok)).to.equal(true);});if(!ok){postman.setNextRequest(null);throw new Error(n);}}var b=pm.response.json();check('HTTP 200',pm.response.code===200);check('Business 200',b.code===200);check('Admin',b.user.userId===1);console.log('T56_EVENT '+JSON.stringify(Object.assign({name:pm.info.requestName,code:b.code},{userId:b.user.userId})));"
            ]
          }
        }
